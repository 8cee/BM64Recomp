{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BM64 Recomp Mod Server Index",
  "type": "object",
  "required": ["schema_version", "game", "mods"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "game": { "type": "string", "const": "bm64" },
    "generated_at": { "type": ["string", "null"] },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "author", "version", "download_url", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "name": { "type": "string" },
          "author": { "type": "string" },
          "version": { "type": "string" },
          "description": { "type": "string" },
          "homepage": { "type": "string" },
          "download_url": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "filename": { "type": "string" },
          "bm64_version": { "type": "string" },
          "android_supported": { "type": "boolean", "default": true }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
